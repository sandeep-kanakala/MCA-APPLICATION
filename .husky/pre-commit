#!/bin/bash

echo "🚀 Running pre-commit checks..."

# Move to repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# --- FRONTEND CHECKS ---
if echo "$STAGED_FILES" | grep -q "^frontend/"; then
  echo "🧩 Running frontend checks..."
  cd frontend || exit 1
  npm run pre-commit || {
    echo '❌ [FRONTEND PRE_COMMIT_ERROR] :: Fix errors above before committing.'
    exit 1
  }
  cd ..
else
  echo "⚙️  No frontend files changed, skipping frontend checks."
fi

# --- BACKEND CHECKS ---
if echo "$STAGED_FILES" | grep -q "^backend/"; then
  echo "🧩 Running backend checks..."
  cd backend || exit 1

  # --- PRISMA MIGRATION CHECK ---
  if echo "$STAGED_FILES" | grep -q "prisma/schema.prisma"; then
    echo "🔍 Checking Prisma migration consistency..."

    # Check if migration directory changes are staged
    MIGRATION_CHANGED=$(echo "$STAGED_FILES" | grep "backend/prisma/migrations/")

    if [ -z "$MIGRATION_CHANGED" ]; then
      echo "❌ Prisma schema was modified but no migration file was created."
      echo "💡 Run: npx prisma migrate dev --name <migration_name>"
      exit 1
    else
      echo "✅ Prisma migration detected."
    fi
  else
    echo "⚙️  Prisma schema not modified, skipping migration check."
  fi

  # --- LINT CHECK ---
  echo "🧹 Running backend lint..."
    npm run format || {
  echo '❌ [BACKEND PRE_COMMIT_ERROR] :: Fix formatting issues before committing.'
  exit 1
}
  echo "✅ Backend formatting passed"
   npm run lint || {
  echo '❌ [BACKEND PRE_COMMIT_ERROR] :: Fix lint errors before committing.'
  exit 1
  }
  echo "✅ Backend lint passed"
  cd ..
else
  echo "⚙️  No backend files changed, skipping backend checks."
fi

echo "✅ All checks passed! Proceeding with commit."
