{
  "name": "multichoice-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "husky": {
    "dir": "../.husky"
  },
  "scripts": {
    "dev": "cross-env RUNTIME_ENV=development npm run generate-runtime-env && vite",
    "build": "cross-env RUNTIME_ENV=development npm run generate-runtime-env && tsc -b && vite build --mode development",
    "build:dev": "cross-env RUNTIME_ENV=development npm run generate-runtime-env && tsc -b && vite build --mode development",
    "build:uat": "cross-env RUNTIME_ENV=uat npm run generate-runtime-env && tsc -b && vite build --mode uat",
    "build:prod": "cross-env RUNTIME_ENV=production npm run generate-runtime-env && tsc -b && vite build --mode production",
    "preview:dev": "vite preview --mode development --port 4173",
    "preview:uat": "vite preview --mode uat --port 4174",
    "preview:prod": "vite preview --mode production --port 4175",
    "generate-runtime-env": "node scripts/generateRuntimeEnv.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "prepare": "cd .. && husky install",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "pre-commit": "lint-staged --allow-empty --concurrent false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.65.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.3",
    "redux": "^5.0.1",
    "sass": "^1.93.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.37.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "ts-jest": "^29.4.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
